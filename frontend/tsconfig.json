{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "ES2022"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    // Berkas uji dijalankan langsung oleh Node (`node --test`), tanpa bundler.
    // Node ESM menuntut ekstensi ditulis lengkap, jadi impor di berkas uji
    // berbunyi "./format.ts". Tanpa opsi ini tsc menolak ekstensi itu. Aman
    // karena "noEmit" menyala — opsi ini memang hanya boleh dipakai begitu.
    "allowImportingTsExtensions": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}

# Salin jadi .env lalu isi nilainya:  cp .env.example .env
# File .env TIDAK PERNAH masuk git.

# --- Port di komputer Anda ------------------------------------------------
# Ubah kalau port-nya sudah dipakai project lain
# ("bind: address already in use" saat docker compose up).
BACKEND_PORT=8000
FRONTEND_PORT=3000
POSTGRES_PORT_HOST=5432
REDIS_PORT_HOST=6379

# --- Django ---------------------------------------------------------------
DJANGO_SECRET_KEY=ganti-dengan-string-acak-panjang
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_LOG_LEVEL=INFO

# --- Database -------------------------------------------------------------
POSTGRES_DB=digify
POSTGRES_USER=digify
POSTGRES_PASSWORD=digify
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Redis ----------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- Gemini ---------------------------------------------------------------
# WAJIB. Kunci ini hanya hidup di container backend — jangan pernah menyalinnya
# ke variabel NEXT_PUBLIC_* atau ke kode frontend.
GEMINI_API_KEY=
# Verifikasi string persisnya dari .env backend Express sebelum deploy (PRD §12).
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT_SECONDS=110
GEMINI_MAX_RETRIES=3

# --- Kuota & throttle -----------------------------------------------------
DAILY_AI_QUOTA=20
# Batas sebulan — ini yang benar-benar menjaga biaya model lifetime.
# Batas harian saja masih mengizinkan ~600 panggilan sebulan.
MONTHLY_AI_QUOTA=120
# Jatah khusus carousel per hari (Tab 9 dan Tab 10 berbagi endpoint yang sama).
DAILY_CAROUSEL_QUOTA=5
AI_BURST_RATE=10/min
AUTH_BURST_RATE=20/min

# --- Auth -----------------------------------------------------------------
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=30

# --- Billing (affiliate.id) ----------------------------------------------
AFFILIATE_ID_WEBHOOK_SECRET=

# --- Frontend -------------------------------------------------------------
# URL Django dari dalam jaringan Docker. Browser tidak pernah memakai ini.
BACKEND_INTERNAL_URL=http://backend:8000

# Halaman pembayaran affiliate.id. Tombol ajakan di halaman depan mengarah
# ke sini. Kalau dikosongkan, tombolnya turun ke bagian "Cara mulai" di
# halaman depan — yang menerangkan alurnya dengan jujur — bukan ke /alat,
# yang pasti melempar pengunjung baru ke form masuk yang tak bisa ia lewati.
# NEXT_PUBLIC_, dan itu tidak apa-apa: ini alamat halaman publik.
NEXT_PUBLIC_URL_BELI=

# --- Produksi saja --------------------------------------------------------
# Panduan lengkap + checklist keamanan: docs/PRODUKSI.md
# DJANGO_CSRF_TRUSTED_ORIGINS=https://app.digify.id
# DJANGO_SECURE_SSL_REDIRECT=1
# GUNICORN_WORKERS=3
# SIMPAN_BACKUP_HARI=14

# .env untuk SERVER PRODUKSI (dipakai docker-compose.deploy.yml).
#
#   cp .env.deploy.example .env   lalu isi semua yang kosong.
#
# Berbeda dari .env.example yang dipakai di komputer sendiri: tidak ada port
# host, dan tidak ada nilai contoh yang aman dibiarkan.
# Berkas ini TIDAK PERNAH masuk git.

# --- Dari mana image ditarik ---------------------------------------------
# Nama akun/organisasi GitHub, huruf kecil semua.
GHCR_OWNER=andifathulms
# `latest` mengikuti main. Untuk mengunci versi, isi dengan sha-<commit>
# yang tertera di halaman Packages — lalu rollback cukup mengganti angka ini.
IMAGE_TAG=latest

# --- Domain & TLS ---------------------------------------------------------
# Harus sudah diarahkan (A record) ke IP server SEBELUM certbot dijalankan.
DIGIFY_DOMAIN=app.digify.id
LETSENCRYPT_EMAIL=

# --- Django ---------------------------------------------------------------
# String acak panjang. Buat dengan:  openssl rand -base64 48
DJANGO_SECRET_KEY=
# Domain asli saja. Jangan pernah `*`.
DJANGO_ALLOWED_HOSTS=app.digify.id,backend
DJANGO_CSRF_TRUSTED_ORIGINS=https://app.digify.id
# JANGAN diisi 1. Nginx sudah mengalihkan http→https di tepi, jadi ini tidak
# menambah keamanan apa pun — tapi merusak satu-satunya jalur yang tidak lewat
# Nginx: Route Handler Next.js memanggil Django lewat http://backend:8000 tanpa
# header X-Forwarded-Proto, Django menganggapnya tidak aman, lalu mengalihkannya
# ke https://backend:8000 yang tidak ada yang mendengarkan. Akibatnya login mati
# dengan "Koneksi ke server terputus" sementara /admin/ tetap normal — karena
# Nginx memang mengirim header itu. Gejalanya menyesatkan; sebabnya baris ini.
DJANGO_SECURE_SSL_REDIRECT=0
DJANGO_LOG_LEVEL=INFO
GUNICORN_WORKERS=3

# --- Database -------------------------------------------------------------
POSTGRES_DB=digify
POSTGRES_USER=digify
# Kata sandi kuat. Compose menolak jalan kalau kosong.
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# --- Gemini ---------------------------------------------------------------
# Kunci ini hanya hidup di container backend — jangan pernah menyalinnya
# ke variabel NEXT_PUBLIC_* atau ke kode frontend.
# Sebelum menerima pembeli: pakai kunci dari project Google Cloud yang
# billing-nya AKTIF. Free tier memakai data Anda untuk melatih model dan
# boleh dibaca peninjau manusia (docs/DECISIONS.md).
GEMINI_API_KEY=
# Verifikasi string persisnya dari .env backend Express sebelum deploy (PRD §12).
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT_SECONDS=110
GEMINI_MAX_RETRIES=3

# --- Kuota & throttle -----------------------------------------------------
DAILY_AI_QUOTA=20
# Batas sebulan — ini yang benar-benar menjaga biaya model lifetime.
# Batas harian saja masih mengizinkan ~600 panggilan sebulan.
MONTHLY_AI_QUOTA=120
# Jatah khusus carousel per hari (Tab 9 dan Tab 10 berbagi endpoint yang sama).
DAILY_CAROUSEL_QUOTA=5
AI_BURST_RATE=10/min
AUTH_BURST_RATE=20/min

# --- Auth -----------------------------------------------------------------
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=30

# --- Billing (affiliate.id) ----------------------------------------------
# Tanpa ini semua webhook ditolak — dan itu memang disengaja.
AFFILIATE_ID_WEBHOOK_SECRET=

# --- Backup ---------------------------------------------------------------
SIMPAN_BACKUP_HARI=14

# --- Catatan ---------------------------------------------------------------
# NEXT_PUBLIC_URL_BELI TIDAK ada di sini, dan itu bukan kelalaian: nilainya
# dijahit ke bundel saat image frontend dibangun, bukan saat kontainer jalan.
# Isinya diatur di GitHub → Settings → Secrets and variables → Actions →
# Variables. Mengubahnya butuh build ulang.
